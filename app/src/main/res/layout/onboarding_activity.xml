<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true"
    tools:context=".activities.onboarding.OnboardingActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="80dp">

        <!-- Activity header (icon + title) -->
        <include layout="@layout/common_header_activity" />

        <!-- Tips on / off - the same setting as the welcome choice -->
        <pl.hexmind.mindshaper.common.ui.views.HexSwitchRow
            android:id="@+id/switch_onboarding_tips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/workshop_onboarding_tips_switch" />

        <!-- Feature benefit - shown only while the tips are off -->
        <TextView
            android:id="@+id/tv_onboarding_tips_hint"
            style="@style/TextView_Section_Info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/workshop_onboarding_tips_hint" />

        <!-- Progress and sections - hidden while the tips are off -->
        <LinearLayout
            android:id="@+id/ll_onboarding_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <pl.hexmind.mindshaper.common.ui.views.HexDottedSeparator
                style="@style/AppCardView_Divider"
                android:layout_marginTop="8dp" />

            <!-- Overall progress: seen tips out of all -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Progress label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:text="@string/workshop_onboarding_progress"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    />

                <!-- Progress bar -->
                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/lpi_onboarding_progress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:indeterminate="false"
                    app:trackThickness="8dp"
                    app:trackCornerRadius="4dp"
                    app:indicatorTrackGapSize="0dp"
                    app:indicatorColor="@color/_orange_lvl_3"
                    app:trackColor="@color/_orange_lvl_1"
                    />

                <!-- Progress percent -->
                <TextView
                    android:id="@+id/tv_onboarding_progress_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:minWidth="40dp"
                    android:gravity="end"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    tools:text="40%"
                    />

            </LinearLayout>

            <!-- Onboarding cards list -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_onboarding_sections"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                tools:listitem="@layout/onboarding_card_item"
                />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
