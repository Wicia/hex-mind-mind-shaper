<?xml version="1.0" encoding="utf-8"?>
<!-- One flashcard in a preview list (set preview, loose flashcards tab): front (bold) and back, level hexagon on the right - tap = FlashcardEditDialog, long press = delete -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp"
    android:clipChildren="false"
    android:background="@drawable/shape_flashcard_card"
    android:elevation="4dp"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_preview_front"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:fontFamily="@font/literata_regular"
            android:lineSpacingMultiplier="@dimen/line_spacing_tight"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:ellipsize="end"
            tools:text="Stolica Mongolii?"
            />

        <!-- ! includeFontPadding off on both: Literata's own padding would make the front-back gap much bigger than the margin -->
        <TextView
            android:id="@+id/tv_preview_back"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:includeFontPadding="false"
            android:textSize="16sp"
            android:lineSpacingMultiplier="0.85"
            android:textColor="@color/text_primary"
            android:fontFamily="@font/literata_regular"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Ułan Bator" />

    </LinearLayout>

    <!-- Level: "lvl: N" on top (mastered = star sending out a signal), hexagon below
         ! clipChildren off here and on the row - the signal ring grows past its bounds -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:clipChildren="false"
        android:layout_marginStart="12dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipChildren="false">

            <!-- Signal of the mastered star: ring growing out of it and fading (animated in code) -->
            <View
                android:id="@+id/v_preview_level_signal"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:background="@drawable/shape_star_signal"
                android:alpha="0"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_preview_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textSize="15sp"
                android:textColor="@color/text_secondary"
                tools:text="lvl: 2" />

        </FrameLayout>

        <!-- Level hexagon -->
        <pl.hexmind.mindshaper.common.ui.views.HexLevelHexagon
            android:id="@+id/v_preview_level_hexagon"
            android:layout_width="@dimen/flashcard_level_hexagon_size"
            android:layout_height="@dimen/flashcard_level_hexagon_size"
            android:layout_marginTop="2dp"
            />

    </LinearLayout>

</LinearLayout>
