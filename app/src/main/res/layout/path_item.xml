<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ll_path_card"
    android:layout_width="match_parent"
    android:layout_height="100dp"
    android:orientation="horizontal"
    android:padding="10dp"
    android:background="@drawable/shape_hex_content">

    <!-- !
    fixed height, not wrap+minHeight: match_parent children stretched to the whole viewport
    under NestedScrollView fillViewport when a tab showed a single short card
    -->

    <!-- Actions -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- "Repicking" action -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_path_redraw"
            style="@style/SecondaryActionButton.Ghost"
            android:layout_width="36dp"
            android:layout_height="36dp"
            app:icon="@drawable/ic_replace_or_renew"
            app:iconGravity="textStart"
            app:iconSize="28dp"
            />

        <View
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="8dp"
            />

        <!-- "Proceed" action -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_path_proceed_action"
            style="@style/SecondaryActionButton.Ghost"
            android:layout_width="36dp"
            android:layout_height="36dp"
            app:icon="@drawable/ic_action_edit"
            app:iconGravity="textStart"
            app:iconSize="28dp"
            />

    </LinearLayout>

    <!-- Separator -->
    <View
        android:id="@+id/v_path_separator"
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginStart="10dp"
        android:background="@color/_orange_lvl_0"
        />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Category or Step content -->
        <TextView
            android:id="@+id/tv_path_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="4"
            android:ellipsize="end"
            android:textSize="14sp"
            android:textAlignment="center"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:lineSpacingMultiplier="0.85"
            android:padding="4dp"
            />

        <!-- Step count -->
        <TextView
            android:id="@+id/tv_workshop_path_steps_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lines="1"
            android:textSize="13sp"
            android:textColor="@color/_gray_lvl_3"
            android:textAlignment="center"
            android:visibility="invisible"
            />

    </LinearLayout>

</LinearLayout>
