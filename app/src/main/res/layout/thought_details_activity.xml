<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/ll_details_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ============================== -->
            <!-- TOP BAR: tags | value | icons  -->
            <!-- ============================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp"
                android:baselineAligned="false">

                <!-- LEFT: HEX TAGS -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_hex_tags"
                    style="@style/MetadataContentButton.Used"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="@string/common_btn_create"
                    android:textColor="@color/_orange_lvl_3"
                    app:icon="@drawable/ic_hex_tags"
                    app:iconGravity="textEnd"
                    app:iconSize="36dp" />

                <!-- CENTER: value -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="4dp"
                    android:orientation="horizontal">

                    <!-- * Decorator / "Secret" Decrease Button * -->
                    <ImageView
                        android:id="@+id/btn_value_decrease"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center_vertical"
                        android:contentDescription="@string/common_placeholder_accessibility_content_desc"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        app:srcCompat="@drawable/ic_decorator_olive"
                        app:tint="@color/_gray_lvl_2"
                        android:rotation="-15" />

                    <pl.hexmind.mindshaper.common.ui.views.values.ValueCloude
                        android:id="@+id/vb_thought_value"
                        style="@style/ValueCloude"
                        android:layout_width="65dp"
                        android:layout_height="65dp"
                        app:valueTextSize="18sp"
                        />

                    <!-- * Decorator / "Secret" Increase Button * -->
                    <ImageView
                        android:id="@+id/btn_value_increase"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center_vertical"
                        android:contentDescription="@string/common_placeholder_accessibility_content_desc"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:scaleX="-1"
                        android:rotation="15"
                        app:srcCompat="@drawable/ic_decorator_olive"
                        app:tint="@color/_gray_lvl_2" />

                </LinearLayout>

                <!-- RIGHT: status icon (for different states / modes) -->
                <ImageView
                    android:id="@+id/iv_status"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/common_placeholder_accessibility_content_desc"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:src="@drawable/ic_status_locked"
                    app:tint="@color/_gray_lvl_2" />

            </LinearLayout>

            <!-- SUBJECT ROW -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:baselineAligned="false">

                <!-- SUBJECT: empty -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_subject_placeholder"
                    style="@style/MetadataContentButton.NotUsed"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/common_btn_add"
                    app:icon="@drawable/ic_hextags_subject"
                    app:iconSize="36dp" />

                <!-- SUBJECT: Content -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tv_subject"
                    style="@style/MetadataContentButton.Used"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    app:icon="@drawable/ic_hextags_subject"
                    app:iconSize="36dp"
                    android:visibility="gone" />

            </LinearLayout>


            <!-- =============================== -->
            <!-- THOUGHT REPRESENTATIONS SECTION -->
            <!-- =============================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="48dp"
                android:orientation="vertical">

                <!-- RICH TEXT : Note -->
                <pl.hexmind.mindshaper.common.ui.views.content.HexTextView
                    android:id="@+id/rich_text_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone"
                    app:richTextMode="editDisplay" />

                <!-- SOUND RECORDING : Media player for audio -->
                <pl.hexmind.mindshaper.common.ui.views.content.HexAudioView
                    android:id="@+id/audio_recording_playback"
                    style="@style/RecordingPlaybackView_UsedWithTint"
                    app:recordingMode="recordPlayback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:padding="24dp"
                    android:visibility="gone" />

                <!-- PHOTO : Content -->
                <pl.hexmind.mindshaper.common.ui.views.content.HexPhotoView
                    android:id="@+id/photo_display_view"
                    style="@style/PhotoDisplayView_UsedWithTint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone"
                    app:photoMode="captureDisplay"
                    app:compact="false" />

                <!-- ADD CONTENT TOOLBAR -->
                <LinearLayout
                    android:id="@+id/ll_add_content_toolbar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="start"
                    android:layout_gravity="start"
                    android:paddingVertical="4dp">

                    <!-- BTN ADD - Rich Text -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_rich_text_add"
                        style="@style/HexContentButton.NotUsed"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginEnd="4dp"
                        android:text="@string/common_btn_create"
                        app:icon="@drawable/ic_thought_type_rich_text"
                        app:iconGravity="textEnd"
                        app:iconSize="32dp"
                        />

                    <!-- BTN ADD - Recording -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_recording_add"
                        style="@style/HexContentButton.NotUsed"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginEnd="4dp"
                        android:text="@string/common_btn_create"
                        app:icon="@drawable/ic_thought_type_recording"
                        app:iconGravity="textEnd"
                        app:iconSize="32dp"
                        />

                    <!-- BTN ADD - Photo -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_photo_add"
                        style="@style/HexContentButton.NotUsed"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="@string/common_btn_create"
                        app:icon="@drawable/ic_thought_type_photo"
                        app:iconGravity="textEnd"
                        app:iconSize="32dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- ============================== -->
            <!--    Linked steps                -->
            <!-- ============================== -->
            <TextView
                android:id="@+id/tv_usage_header"
                style="@style/TextView_Section_Info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/details_usage_not_linked" />

            <!-- Empty state (no link) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_usage_link"
                style="@style/ThoughtLinkButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginBottom="90dp"
                android:text="@string/details_usage_link_button"
                app:icon="@drawable/ic_action_thought_link" />

            <!-- Linked state -->
            <LinearLayout
                android:id="@+id/ll_usage_linked"
                android:focusable="true"
                android:clickable="true"
                android:foreground="?attr/selectableItemBackground"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="90dp"
                android:weightSum="10"
                android:background="@drawable/shape_hex_content"
                android:backgroundTint="@color/button_content_filled_background"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp"
                android:visibility="visible">

                <!-- Unlink button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_usage_unlink"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1.25"
                    app:backgroundTint="@color/_orange_lvl_1"
                    app:icon="@drawable/ic_replace_or_renew"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="28dp"
                    app:iconTint="@color/_orange_lvl_3" />

                <TextView
                    android:id="@+id/tv_usage_goal_context"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="8"
                    android:fontFamily="@font/baloo2"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="-1dp"
                    android:minLines="1"
                    android:ellipsize="end"
                    android:textSize="14sp" />

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="0.75"
                    android:contentDescription="@string/common_placeholder_accessibility_content_desc"
                    app:srcCompat="@drawable/ic_action_chevron_right"
                    app:tint="@color/_gray_lvl_2" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>