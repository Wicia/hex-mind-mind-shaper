<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Goal header row -->
    <LinearLayout
        android:id="@+id/ll_goal_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:background="?attr/selectableItemBackground">

        <!-- Priority badge (1/2/3) -->
        <TextView
            android:id="@+id/tv_priority_badge"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:background="@drawable/shape_workshop_priority_badge" />

        <!-- Goal description -->
        <TextView
            android:id="@+id/tv_goal_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:lineSpacingExtra="1dp" />

        <!-- Navigation arrow (detail) -->
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_section_expand"
            android:rotation="-90"
            android:contentDescription="@string/common_placeholder_accessibility_content_desc"
            app:tint="@color/_gray_lvl_3" />

    </LinearLayout>

</LinearLayout>
