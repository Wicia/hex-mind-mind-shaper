<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="@color/hex_card_background">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nested_scroll_view"
        android:clickable="false"
        android:focusable="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- VALUE CLOUDE -->
            <pl.hexmind.mindshaper.common.ui.views.values.ValueCloude
                android:id="@+id/vb_thought_value"
                style="@style/ValueCloude"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_gravity="center"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                />

            <!-- HEADER: Icon + Label -->
            <LinearLayout
                android:id="@+id/ll_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="start|center_vertical"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/iv_decorator_icon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_decorator_label"
                    app:tint="@color/_orange_lvl_2"
                    android:rotation="90"
                    android:contentDescription="@string/common_placeholder_accessibility_content_desc" />

                <TextView
                    android:id="@+id/tv_label"
                    style="@style/TextView_Metadata"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

            <!-- for EMPTY THOUGHT scenario -->
            <TextView
                android:id="@+id/tv_empty_thought"
                style="@style/TextView_Metadata"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textStyle="bold"
                android:text="@string/stream_item_empty_thought"
                android:textAlignment="center"
                android:layout_marginTop="32dp"
                android:padding="32dp" />

            <!-- RICH TEXT -->
            <pl.hexmind.mindshaper.common.ui.views.content.HexTextView
                android:id="@+id/rich_text_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                app:richTextMode="displayOnly" />

            <!-- AUDIO RECORDING -->
            <pl.hexmind.mindshaper.common.ui.views.content.AudioRecordingView
                android:id="@+id/arv_playback"
                app:recordingMode="playbackOnly"
                app:compact="true"
                style="@style/RecordingPlaybackView_UsedWithTint"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone" />

            <!-- PHOTO -->
            <pl.hexmind.mindshaper.common.ui.views.content.HexPhotoView
                android:id="@+id/pv_photo"
                style="@style/PhotoDisplayView_UsedWithTint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                app:photoMode="displayOnly" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.cardview.widget.CardView>