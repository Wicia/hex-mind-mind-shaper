<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="@color/hex_card_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- SCROLLABLE CONTENT + fade overlay -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/nested_scroll_view"
                android:clickable="false"
                android:focusable="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- SUBJECT LABEL (shown / hidden) -->
                    <TextView
                        android:id="@+id/tv_subject_label"
                        style="@style/TextView_Metadata"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginBottom="0dp"
                        android:textColor="@color/text_secondary" />

                    <!-- RICH TEXT -->
                    <pl.hexmind.mindshaper.common.ui.views.content.MarkdownTextView
                        android:id="@+id/rich_text_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:layout_marginBottom="16dp"
                        android:visibility="gone"
                        app:richTextMode="displayOnly"
                        />

                    <!-- AUDIO RECORDING -->
                    <pl.hexmind.mindshaper.common.ui.views.content.HexAudioView
                        android:id="@+id/arv_playback"
                        app:recordingMode="playbackOnly"
                        app:compact="true"
                        style="@style/RecordingPlaybackView_UsedWithTint"
                        android:background="@null"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:visibility="gone" />

                    <!-- PHOTO -->
                    <pl.hexmind.mindshaper.common.ui.views.content.HexPhotoView
                        android:id="@+id/pv_photo"
                        style="@style/PhotoDisplayView_UsedWithTint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:visibility="gone"
                        app:photoMode="displayOnly" />

                    <!-- for EMPTY THOUGHT scenario -->
                    <TextView
                        android:id="@+id/tv_empty_thought"
                        style="@style/TextView_Metadata"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:textStyle="bold"
                        android:text="@string/stream_item_empty_thought"
                        android:textAlignment="center"
                        android:layout_marginTop="32dp"
                        android:padding="32dp" />

                </LinearLayout>

            </androidx.core.widget.NestedScrollView>

            <!-- Gradient fade overlay -->
            <View
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_gravity="bottom"
                android:background="@drawable/gradient_steam_item_bar"
                android:clickable="false"
                android:focusable="false" />

        </FrameLayout>

        <!-- BOTTOM BAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:background="@color/_orange_lvl_0">

            <!-- LEFT: value cloud / icon + label (80%) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="4"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- VALUE CLOUD -->
                <pl.hexmind.mindshaper.common.ui.views.values.ValueCloude
                    android:id="@+id/vb_thought_value"
                    style="@style/ValueCloude"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:cloudColor="@color/_orange_lvl_1"
                    app:valueTextSize="14sp"
                    app:valueTextColor="@color/_gray_lvl_2"
                    android:visibility="gone"
                    />

                <!-- Icon -->
                <ImageView
                    android:id="@+id/iv_decorator_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_decorator_label"
                    app:tint="@color/_gray_lvl_2"
                    android:contentDescription="@string/common_placeholder_accessibility_content_desc"
                    android:visibility="gone" />

                <!-- Text or "Emoji Icon" -->
                <TextView
                    android:id="@+id/tv_text_icon"
                    style="@style/TextView_Metadata"
                    android:textColor="@color/_gray_lvl_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:gravity="center_vertical"
                    android:visibility="gone" />

                <!-- Label text -->
                <TextView
                    android:id="@+id/tv_label"
                    style="@style/TextView_Metadata"
                    android:textColor="@color/_gray_lvl_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- RIGHT: image (20%) -->
            <ImageView
                android:id="@+id/iv_status_icon"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:layout_gravity="bottom"
                android:scaleType="fitEnd"
                android:src="@drawable/ic_decorator_label"
                android:contentDescription="@string/common_placeholder_accessibility_content_desc"
                 />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>