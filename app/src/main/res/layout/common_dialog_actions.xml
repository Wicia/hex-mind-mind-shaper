<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tv_question"
        style="@style/Dialog_Header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Co chcesz zrobić z nagraniem?"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="24dp"
        />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_action_caution"
            style="@style/SecondaryActionButton"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="Wywalić"
            android:textStyle="bold"
            />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_action_standard"
            style="@style/SecondaryActionButton"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Nadpisać"
            />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_cancel"
        style="@style/AuxiliaryActionButton"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:text="Anuluj"
        android:layout_gravity="center_horizontal"
        />

</LinearLayout>