<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    tools:context=".activities.workshop.WorkshopActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="80dp">

            <include layout="@layout/common_header_activity" />

            <!-- Tabs -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabs_workshop"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                app:tabBackground="@drawable/tab_background_selector"
                app:tabIndicatorHeight="0dp"
                app:tabMode="fixed"
                app:tabGravity="fill"
                app:tabPaddingStart="8dp"
                app:tabPaddingEnd="8dp"
                app:tabRippleColor="@null"
                />

            <!-- === GOALS section === -->
            <!-- TODO: one approach needs to be chosen -> this or MaterialCardView in all places -->
            <LinearLayout
                android:id="@+id/card_goals"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="vertical">

                <!-- shape_card_tab_joined draws surface, corners and outline in one drawable -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/shape_card_tab_joined">

                    <LinearLayout
                        android:id="@+id/ll_goals_section_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tv_your_name_section_header"
                            style="@style/HexCard_Header"
                            android:layout_weight="1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="4dp"
                            android:text="@string/workshop_section_goals" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_add_goal"
                            style="@style/SecondaryActionButton"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            app:icon="@drawable/ic_action_add"
                            app:iconGravity="textStart"
                            app:iconSize="16dp" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_goals"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never"
                        tools:listitem="@layout/goal_item" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_goals_toggle"
                        style="@style/SecondaryActionButton.Ghost"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="4dp"
                        android:visibility="gone"
                        />

                    <!-- === ARCHIVE === -->
                    <!-- Whole block hides when nothing is archived -->
                    <!-- 1dp insets keep the panel on the white surface instead of covering the card border -->
                    <LinearLayout
                        android:id="@+id/ll_goals_archive"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="1dp"
                        android:layout_marginEnd="1dp"
                        android:layout_marginBottom="1dp"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical"
                        android:background="@drawable/shape_card_archive"
                        android:visibility="gone">

                        <!-- Collapsible header: whole row toggles the archive (bench of past goals) -->
                        <LinearLayout
                            android:id="@+id/ll_goals_archive_header"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="?attr/selectableItemBackground"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp">

                            <TextView
                                android:id="@+id/tv_goals_archive_header"
                                style="@style/HexCard_Header"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="20dp"
                                android:layout_marginTop="0dp"
                                android:layout_marginBottom="0dp"
                                android:textColor="@color/text_secondary"
                                android:text="@string/workshop_section_goals_archive"
                                />

                            <ImageView
                                android:id="@+id/iv_goals_archive_chevron"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_marginEnd="16dp"
                                android:src="@drawable/ic_action_chevron_right"
                                android:contentDescription="@string/common_placeholder_accessibility_content_desc"
                                app:tint="@color/_gray_lvl_3"
                                />

                        </LinearLayout>

                        <!-- Collapsable content -->
                        <LinearLayout
                            android:id="@+id/ll_goals_archive_content"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rv_goals_archive"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:nestedScrollingEnabled="false"
                                android:overScrollMode="never"
                                tools:listitem="@layout/goal_item"
                                />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_goals_archive_more"
                                style="@style/SecondaryActionButton.Ghost"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginTop="4dp"
                                android:layout_marginBottom="4dp"
                                android:visibility="gone"
                                />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- === PATHS section === -->
            <LinearLayout
                android:id="@+id/card_paths"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/shape_card_tab_joined">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="12dp">

                        <TextView
                            style="@style/HexCard_Header"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="4dp"
                            android:text="@string/workshop_section_paths" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_paths_reset"
                            style="@style/SecondaryActionButton"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            app:icon="@drawable/ic_replace_or_renew"
                            app:iconGravity="textStart"
                            app:iconSize="24dp" />

                    </LinearLayout>

                    <!-- Dynamic path step cards (handled in code) -->
                    <LinearLayout
                        android:id="@+id/ll_paths_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="10dp" />

                    <!-- Special info -->
                    <TextView
                        android:id="@+id/tv_paths_pool_empty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/workshop_path_pool_empty"
                        android:textSize="13sp"
                        android:textColor="@color/_gray_lvl_3"
                        android:textAlignment="center"
                        android:padding="20dp"
                        android:visibility="gone" />

                </LinearLayout>

            </LinearLayout>

            <!-- === ONBOARDING REVIEW section === -->
            <!-- Outside the tabs widget -->
            <LinearLayout
                android:id="@+id/card_onboarding"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:background="@drawable/shape_card_onboarding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp">

                    <TextView
                        style="@style/TextView_Header_Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="8dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="0dp"
                        android:text="@string/workshop_section_onboarding" />

                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_onboarding_sections"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    android:paddingBottom="8dp"
                    tools:listitem="@layout/onboarding_section_item" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- fab - Capture thought -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_capture"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:src="@drawable/ic_capture_thought"
        app:backgroundTint="@color/button_primary_enabled_background"
        app:fabSize="normal"
        app:elevation="6dp"
        android:contentDescription="@string/common_placeholder_accessibility_content_desc" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>