<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    tools:context=".activities.workshop.WorkshopActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="80dp">

            <include layout="@layout/common_header_activity" />

            <!-- Tab switch (Cele / Ścieżki) -->
            <pl.hexmind.mindshaper.common.ui.views.HexTabSwitch
                android:id="@+id/tabs_workshop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                />

            <!-- === GOALS section === -->
            <!-- TODO: one approach needs to be chosen -> this or MaterialCardView in all places -->
            <LinearLayout
                android:id="@+id/card_goals"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="16dp"
                android:orientation="vertical">

                <!-- shape_card_standalone draws surface, corners and outline in one drawable -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/shape_card_standalone">

                    <LinearLayout
                        android:id="@+id/ll_goals_section_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="12dp">

                        <!-- Aktywne cele / Archiwalne cele - follows the list shown below -->
                        <TextView
                            android:id="@+id/tv_goals_section_header"
                            style="@style/HexCard_Header"
                            android:layout_weight="1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="4dp"
                            android:text="@string/workshop_section_goals_active" />

                        <!-- Which goals to show: active / archived (WorkshopGoalsViewBottomSheet) - same button as the paths' reset -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_goals_view"
                            style="@style/SecondaryActionButton"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:contentDescription="@string/workshop_goals_view_title"
                            app:icon="@drawable/ic_goals_view_filter"
                            app:iconGravity="textStart"
                            app:iconSize="24dp" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_goals"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="12dp"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never"
                        tools:listitem="@layout/goal_item" />

                    <!-- Empty state: no active goals -->
                    <TextView
                        android:id="@+id/tv_goals_empty"
                        style="@style/TextView_EmptyState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/workshop_goals_empty"
                        android:padding="20dp"
                        android:visibility="gone" />

                </LinearLayout>

                <!-- Pokaż jeszcze N / Pokaż mniej - hangs from the card's bottom edge, -1dp overlaps it (no seam) -->
                <pl.hexmind.mindshaper.common.ui.views.HexPullTab
                    android:id="@+id/pt_goals_toggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="-1dp"
                    android:visibility="gone"
                    app:tabColor="@android:color/white" />

            </LinearLayout>

            <!-- === PATHS section === -->
            <LinearLayout
                android:id="@+id/card_paths"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="16dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/shape_card_standalone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="12dp">

                        <TextView
                            style="@style/HexCard_Header"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="4dp"
                            android:text="@string/workshop_section_paths" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_paths_reset"
                            style="@style/SecondaryActionButton"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            app:icon="@drawable/ic_replace_or_renew"
                            app:iconGravity="textStart"
                            app:iconSize="24dp" />

                    </LinearLayout>

                    <!-- Dynamic path step cards (handled in code) -->
                    <LinearLayout
                        android:id="@+id/ll_paths_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp" />

                    <!-- Special info -->
                    <TextView
                        android:id="@+id/tv_paths_pool_empty"
                        style="@style/TextView_EmptyState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/workshop_path_pool_empty"
                        android:padding="20dp"
                        android:visibility="gone" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- fab - Add goal (Goals tab only) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add_goal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:src="@drawable/ic_action_add"
        app:backgroundTint="@color/button_primary_enabled_background"
        app:fabSize="normal"
        app:elevation="6dp"
        android:contentDescription="@string/common_placeholder_accessibility_content_desc" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>