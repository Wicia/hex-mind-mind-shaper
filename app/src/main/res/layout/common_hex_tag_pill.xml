<?xml version="1.0" encoding="utf-8"?>
<!-- Hex tag pill split in two tappable parts: name (edit) | usage count + lens (search in Stream) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/hex_tag_pill_spacing"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/shape_hex_chip_selected"
    >

    <!-- Part 1: tag name -->
    <TextView
        android:id="@+id/tv_pill_name"
        style="@style/TextView_Metadata"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="48dp"
        android:background="@drawable/ripple_hex_tag_pill_start"
        android:paddingStart="14dp"
        android:paddingEnd="10dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:maxEms="8"
        android:textColor="@color/text_primary"
        />

    <!-- Separator between the two parts: cuts the pill through its full height -->
    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="@color/app_background"
        />

    <!-- Part 2: usage count + search hint -->
    <LinearLayout
        android:id="@+id/ll_pill_search"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/ripple_hex_tag_pill_end"
        android:paddingStart="8dp"
        android:paddingEnd="12dp"
        android:contentDescription="@string/metadata_tag_search"
        >

        <TextView
            android:id="@+id/tv_pill_count"
            style="@style/TextView_Metadata"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/graphite_soft"
            />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_search"
            android:tint="@color/graphite_soft"
            android:contentDescription="@null"
            />

    </LinearLayout>

</LinearLayout>
