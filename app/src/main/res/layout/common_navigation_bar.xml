<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/navigationBar"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <View
        android:id="@+id/navDrawerScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/navDrawer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:background="@drawable/nav_drawer_gradient"
        android:paddingStart="64dp"
        android:paddingEnd="44dp"
        android:elevation="12dp"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/navButtonsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:clipChildren="false"
            android:clipToPadding="false">

            <pl.hexmind.mindshaper.common.ui.HexNavItemView
                android:id="@+id/navHome"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="?attr/selectableItemBackground"
                app:hexNavLabel="@string/home_title"
                app:hexNavIcon="@drawable/ic_activity_home" />

            <pl.hexmind.mindshaper.common.ui.HexNavItemView
                android:id="@+id/navStream"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="?attr/selectableItemBackground"
                app:hexNavLabel="@string/stream_title"
                app:hexNavIcon="@drawable/ic_activity_stream" />

            <pl.hexmind.mindshaper.common.ui.HexNavItemView
                android:id="@+id/navWorkshop"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="?attr/selectableItemBackground"
                app:hexNavLabel="@string/workshop_title"
                app:hexNavIcon="@drawable/ic_activity_workshop" />

            <pl.hexmind.mindshaper.common.ui.HexNavItemView
                android:id="@+id/navSettings"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="?attr/selectableItemBackground"
                app:hexNavLabel="@string/settings_title"
                app:hexNavIcon="@drawable/ic_activity_settings" />

        </LinearLayout>
    </LinearLayout>

    <!-- Single navigation button: opens/closes the drawer. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnToggle"
        style="@style/AuxiliaryActionButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="8dp"
        android:elevation="16dp"
        android:contentDescription="@string/common_placeholder_accessibility_content_desc"
        app:icon="@drawable/ic_nav_expand" />

</FrameLayout>
