<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/navigationBar"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/nav_bar"
    android:padding="8dp"
    android:clipToPadding="false"
    android:clipChildren="false"
    android:gravity="center_vertical">

    <!-- Navigation (toggle) button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnToggle"
        style="@style/AuxiliaryActionButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_vertical"
        app:icon="@drawable/ic_nav_expand"
        />

    <!-- Container for navigation buttons -->
    <LinearLayout
        android:id="@+id/navButtonsContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="center_vertical"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Button 1: Home -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/navHome"
            style="@style/AuxiliaryActionButton"
            app:icon="@drawable/ic_capture_thought"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="16dp"
            />

        <!-- Button 2: Stream -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/navStream"
            style="@style/AuxiliaryActionButton"
            app:icon="@drawable/ic_activity_stream"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="12dp"
            />

        <!-- Button 3: Workshop -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/navWorkshop"
            style="@style/AuxiliaryActionButton"
            app:icon="@drawable/ic_activity_workshop"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="12dp"
            />

        <!-- Button 4: SETTINGS -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/navSettings"
            style="@style/AuxiliaryActionButton"
            app:icon="@drawable/ic_activity_settings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="12dp"
            />

    </LinearLayout>

</LinearLayout>