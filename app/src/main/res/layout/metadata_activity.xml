<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_background"
    tools:context=".activities.metadata.MetadataActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <!-- ! clipChildren / clipToPadding false: the domain tiles' shadows fall into the 16dp padding - clipped here, their sides would look cut off -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="80dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Activity header (icon + title) -->
            <include layout="@layout/common_header_activity" />

            <!-- Metadata type switch (Osoby / Projekty / Domeny) -->
            <pl.hexmind.mindshaper.common.ui.views.HexTabSwitch
                android:id="@+id/tabs_tag_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                />

            <!-- Tag merge mode: what to tap next - shown only while merging -->
            <TextView
                android:id="@+id/tv_merge_hint"
                style="@style/TextView_Metadata"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textAlignment="center"
                android:textColor="@color/text_primary"
                android:visibility="gone"
                />

            <!-- Tags list -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_tags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginStart="12dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                />

            <!-- Empty state -->
            <TextView
                android:id="@+id/tv_tags_empty"
                style="@style/TextView_EmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:text="@string/metadata_persons_empty"
                android:visibility="gone"
                />

            <!-- Domains grid -->
            <GridLayout
                android:id="@+id/gl_domains"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:alignmentMode="alignBounds"
                android:columnCount="2"
                android:columnOrderPreserved="false"
                android:rowCount="4"
                android:visibility="gone"
                />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- fab - tag merge mode (Persons / Projects only): tag A, then tag B, then "replace B with A?" -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_merge_tags"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:src="@drawable/ic_action_merge"
        app:backgroundTint="@color/button_primary_enabled_background"
        app:fabSize="normal"
        app:elevation="6dp"
        android:visibility="gone"
        android:contentDescription="@string/metadata_tag_merge_start"
        />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
