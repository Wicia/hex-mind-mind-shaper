<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    tools:context=".activities.flashcards.FlashcardsActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <!-- ! clipChildren / clipToPadding false: the cards' shadows fall into the 16dp padding - clipped here, their sides would look cut off -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="80dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Activity header (icon + title) -->
            <include layout="@layout/common_header_activity" />

            <!-- Today's session widget: one session over all the flashcards (sets + loose)
                 ! -10dp = HexWavyFrameView.LINE_INSET_DP - the frame line lines up with the set cards' edges,
                 its glow falls into the column's 16dp padding -->
            <include
                android:id="@+id/inc_review_today"
                layout="@layout/flashcards_review_today"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginHorizontal="-10dp"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Tab switch (Luźne fiszki / Zestawy) -->
            <pl.hexmind.mindshaper.common.ui.views.HexTabSwitch
                android:id="@+id/tabs_flashcards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                />

            <!-- Loose flashcards: flashcard_preview_row -->
            <LinearLayout
                android:id="@+id/ll_loose_flashcards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                />

            <!-- Loose flashcards - empty state -->
            <TextView
                android:id="@+id/tv_loose_empty"
                style="@style/TextView_EmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:text="@string/flashcards_loose_empty"
                android:visibility="gone"
                />

            <!-- Sets: flashcards_set_item -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_sets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <!-- Sets - empty state -->
            <TextView
                android:id="@+id/tv_sets_empty"
                style="@style/TextView_EmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:text="@string/flashcards_sets_empty"
                android:visibility="gone" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Speed dial (Luźne fiszki tab) -->
    <include layout="@layout/common_speed_dial" />

    <!-- fab - speed dial (Luźne fiszki) / New set (Zestawy) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:src="@drawable/ic_action_add"
        app:backgroundTint="@color/button_primary_enabled_background"
        app:fabSize="normal"
        app:elevation="6dp"
        android:contentDescription="@string/common_placeholder_accessibility_content_desc" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
