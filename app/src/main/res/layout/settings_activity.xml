<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_background">

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="90dp">

            <!-- Header -->
            <include layout="@layout/common_header_activity" />

            <!-- === PERSONALISATION === -->
            <androidx.cardview.widget.CardView
                style="@style/AppCardView">

                <LinearLayout
                    style="@style/AppCardView_Content">

                    <!-- Your name -->
                    <TextView
                        android:id="@+id/tv_your_name_section_header"
                        style="@style/AppCardView_Header"
                        android:text="@string/settings_your_name_header" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:hintTextColor="@color/_palette_lvl_3">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_your_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/shape_edit_text"
                            android:inputType="text"
                            android:maxLines="1" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <pl.hexmind.mindshaper.common.ui.views.HexDottedSeparator style="@style/AppCardView_Divider" />

                    <!-- Color palette -->
                    <TextView
                        android:id="@+id/tv_color_palette_section_header"
                        style="@style/AppCardView_Header"
                        android:text="@string/settings_color_palette_header" />

                    <pl.hexmind.mindshaper.activities.settings.widgets.ColorPaletteTiles
                        android:id="@+id/tiles_color_palette"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <pl.hexmind.mindshaper.common.ui.views.HexDottedSeparator style="@style/AppCardView_Divider" />

                    <!-- Share the app (opens the QR code and link dialog) | installed version -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_share_app"
                            style="@style/AuxiliaryActionButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_share_app_btn_open"
                            app:cornerRadius="12dp"
                            app:icon="@drawable/ic_share"
                            app:iconPadding="8dp" />

                        <TextView
                            android:id="@+id/tv_app_version"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:textSize="12sp"
                            android:textColor="@color/_gray_lvl_2"
                            tools:text="ver 2026_10_22" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- === THOUGHTS === -->
            <androidx.cardview.widget.CardView
                style="@style/AppCardView">

                <LinearLayout
                    style="@style/AppCardView_Content">

                    <TextView
                        style="@style/AppCardView_Header"
                        android:text="@string/settings_permissions_section" />

                    <pl.hexmind.mindshaper.common.ui.views.HexSwitchRow
                        android:id="@+id/switch_voice_recording_feature"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_permissions_voice_recording" />

                    <pl.hexmind.mindshaper.common.ui.views.HexSwitchRow
                        android:id="@+id/switch_photo_feature"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_permissions_photo" />

                    <pl.hexmind.mindshaper.common.ui.views.HexDottedSeparator style="@style/AppCardView_Divider" />

                    <!-- Default way to capture thoughts -->
                    <TextView
                        android:id="@+id/tv_default_capture_form_section_header"
                        style="@style/AppCardView_Header"
                        android:text="@string/settings_default_form_header" />

                    <pl.hexmind.mindshaper.activities.settings.widgets.DefaultCaptureFormTiles
                        android:id="@+id/tiles_default_capture_form"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <pl.hexmind.mindshaper.common.ui.views.HexDottedSeparator style="@style/AppCardView_Divider" />

                    <!-- Thought value scale -->
                    <TextView
                        android:id="@+id/tv_thought_value_scale_section_header"
                        style="@style/AppCardView_Header"
                        android:text="@string/settings_thoughts_value_header" />

                    <TextView
                        style="@style/TextView_Section_Info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:text="@string/settings_thoughts_value_action_info" />

                    <pl.hexmind.mindshaper.activities.settings.widgets.ThoughtValueSystemTiles
                        android:id="@+id/tiles_value_system"
                        android:layout_width="220dp"
                        android:layout_height="wrap_content" />

                    <pl.hexmind.mindshaper.common.ui.views.HexDottedSeparator style="@style/AppCardView_Divider" />

                    <!-- Dormant mode -->
                    <TextView
                        android:id="@+id/tv_dormant_mode_section_header"
                        style="@style/AppCardView_Header"
                        android:text="@string/settings_dormant_mode_header" />

                    <pl.hexmind.mindshaper.common.ui.views.HexSwitchRow
                        android:id="@+id/switch_dormant_mode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_dormant_mode_switch_label" />

                    <!-- Feature benefit - shown only while the mode is off -->
                    <TextView
                        android:id="@+id/tv_dormant_mode_hint"
                        style="@style/TextView_Section_Info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/settings_dormant_mode_info" />

                    <!-- Thresholds - hidden while the mode is off -->
                    <LinearLayout
                        android:id="@+id/ll_dormant_thresholds_picker"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical">

                        <!-- Days threshold row -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="180dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:gravity="end"
                                android:text="@string/settings_dormant_mode_days_label"
                                android:textSize="14sp" />

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_dormant_days"
                                android:layout_width="64dp"
                                android:layout_height="40dp"
                                android:background="@drawable/shape_edit_text"
                                android:gravity="center"
                                android:inputType="number"
                                android:maxLength="2"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="@string/common_unit_days"
                                android:textSize="14sp" />

                        </LinearLayout>

                        <!-- Value threshold row -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:baselineAligned="false"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="180dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:gravity="end"
                                android:text="@string/settings_dormant_mode_value_label"
                                android:textSize="14sp" />

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_dormant_value"
                                android:layout_width="64dp"
                                android:layout_height="40dp"
                                android:background="@drawable/shape_edit_text"
                                android:gravity="center"
                                android:inputType="number"
                                android:maxLength="2"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <!-- Validation error for Dormant Mode -->
                        <TextView
                            android:id="@+id/tv_dormant_mode_error"
                            style="@style/TextView_Info_Error"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:layout_marginStart="16dp"
                            android:layout_gravity="center_horizontal"
                            android:visibility="invisible" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- === MEMORIZING === -->
            <androidx.cardview.widget.CardView
                style="@style/AppCardView">

                <LinearLayout
                    style="@style/AppCardView_Content">

                    <TextView
                        android:id="@+id/tv_memorizing_section_header"
                        style="@style/AppCardView_Header"
                        android:text="@string/settings_memorizing_section" />

                    <pl.hexmind.mindshaper.common.ui.views.HexSwitchRow
                        android:id="@+id/switch_flashcards_feature"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_permissions_flashcards" />

                    <!-- Feature benefit - shown only while flashcards are off -->
                    <TextView
                        android:id="@+id/tv_flashcards_feature_hint"
                        style="@style/TextView_Section_Info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/settings_flashcards_feature_hint" />

                    <!-- Flashcards options - hidden while flashcards are off -->
                    <LinearLayout
                        android:id="@+id/ll_flashcards_options"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Repetitions System params -->
                        <LinearLayout
                            android:id="@+id/ll_flashcards_params_picker"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:layout_marginStart="16dp"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="0dp"
                                android:baselineAligned="false"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="180dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="8dp"
                                    android:gravity="end"
                                    android:text="@string/settings_flashcards_new_per_day_label"
                                    android:textSize="14sp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btn_flashcards_new_per_day_decrease"
                                    style="@style/SecondaryActionButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:minWidth="35dp"
                                    android:text="@string/common_btn_decrease" />

                                <TextView
                                    android:id="@+id/tv_flashcards_new_per_day"
                                    android:layout_width="40dp"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    tools:text="10"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btn_flashcards_new_per_day_increase"
                                    style="@style/SecondaryActionButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:minWidth="35dp"
                                    android:text="@string/common_btn_increase" />

                            </LinearLayout>

                        </LinearLayout>

                        <pl.hexmind.mindshaper.common.ui.views.HexSwitchRow
                            android:id="@+id/switch_flashcards_reminders"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/settings_flashcards_reminders_switch_label" />

                        <!-- Reminder hour - dimmed while the reminders are off -->
                        <TextView
                            android:id="@+id/tv_flashcards_reminder_hour_label"
                            style="@style/TextView_Section_Info"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:layout_marginStart="16dp"
                            android:text="@string/settings_flashcards_reminder_hour_label" />

                        <pl.hexmind.mindshaper.common.ui.views.HexHourPickerView
                            android:id="@+id/hour_picker_flashcards_reminder"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            app:stepMinutes="60" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- === WORKSHOP === -->
            <androidx.cardview.widget.CardView
                style="@style/AppCardView">

                <LinearLayout
                    style="@style/AppCardView_Content">

                    <TextView
                        android:id="@+id/tv_workshop_section_header"
                        style="@style/AppCardView_Header"
                        android:text="@string/settings_workshop_section" />

                    <pl.hexmind.mindshaper.common.ui.views.HexSwitchRow
                        android:id="@+id/switch_workshop_feature"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_permissions_workshop" />

                    <!-- Feature benefit - shown only while the workshop is off -->
                    <TextView
                        android:id="@+id/tv_workshop_feature_hint"
                        style="@style/TextView_Section_Info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/settings_workshop_feature_hint" />

                    <!-- Workshop options - hidden while the workshop is off -->
                    <LinearLayout
                        android:id="@+id/ll_workshop_options"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Calendar reminders of goal steps -->
                        <pl.hexmind.mindshaper.common.ui.views.HexSwitchRow
                            android:id="@+id/switch_calendar_reminders"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/settings_calendar_reminders_switch_label" />

                        <TextView
                            style="@style/TextView_Section_Info"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/settings_calendar_reminders_hint" />

                        <!-- Calendars list (radio buttons) -->
                        <RadioGroup
                            android:id="@+id/rg_calendar_choice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:visibility="gone" />

                        <TextView
                            style="@style/TextView_Section_Info"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_calendar_reminders_sync_hint" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- === START SCREEN === -->
            <androidx.cardview.widget.CardView
                style="@style/AppCardView">

                <LinearLayout
                    style="@style/AppCardView_Content">

                    <TextView
                        android:id="@+id/tv_start_screen_section_header"
                        style="@style/AppCardView_Header"
                        android:text="@string/settings_start_screen_header" />

                    <pl.hexmind.mindshaper.activities.settings.widgets.StartScreenTiles
                        android:id="@+id/tiles_start_screen"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- === BACKUP === -->
            <androidx.cardview.widget.CardView
                style="@style/AppCardView">

                <LinearLayout
                    style="@style/AppCardView_Content">

                    <TextView
                        android:id="@+id/tv_backup_section_header"
                        style="@style/AppCardView_Header"
                        android:text="@string/settings_backup_header" />

                    <pl.hexmind.mindshaper.common.ui.views.HexSwitchRow
                        android:id="@+id/switch_backup_feature"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_permissions_backup" />

                    <TextView
                        style="@style/TextView_Section_Info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_backup_hint" />

                    <TextView
                        android:id="@+id/tv_snapshot_stats"
                        style="@style/TextView_Section_Info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_select_backup"
                            style="@style/SecondaryActionButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:text="@string/settings_backup_select" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_load_backup"
                            style="@style/SecondaryActionButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:enabled="false"
                            android:text="@string/settings_backup_load" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_selected_backup"
                        style="@style/TextView_Section_Info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/files_state_no_file_selected" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <!-- SAVE -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btn_save_settings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:src="@drawable/ic_action_save"
        android:contentDescription="@string/common_placeholder_accessibility_content_desc"
        app:backgroundTint="@color/button_primary_enabled_background"
        app:fabSize="normal"
        app:maxImageSize="32dp"
        app:layout_behavior="com.google.android.material.behavior.HideBottomViewOnScrollBehavior" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
