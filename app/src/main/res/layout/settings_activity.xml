<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="90dp">

            <!-- Header -->
            <include layout="@layout/common_header_activity" />

            <!-- === YOUR NAME === -->
            <androidx.cardview.widget.CardView
                style="@style/AppCardView">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tv_your_name_section_header"
                        style="@style/TextView_Header_Section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="4dp"
                        android:text="@string/settings_your_name_header" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:hintTextColor="#FF8C42">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_your_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/shape_edit_text"
                            android:inputType="text"
                            android:maxLines="1" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- === THOUGHTS === -->
            <androidx.cardview.widget.CardView
                style="@style/AppCardView">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/TextView_Header_Section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/settings_permissions_section" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_voice_recording_feature"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_permissions_voice_recording" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_photo_feature"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_permissions_photo" />

                    <!-- Default way to capture thoughts -->
                    <TextView
                        android:id="@+id/tv_default_capture_form_section_header"
                        style="@style/TextView_Header_Section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="@string/settings_default_form_header" />

                    <pl.hexmind.mindshaper.activities.settings.widgets.DefaultCaptureFormTiles
                        android:id="@+id/tiles_default_capture_form"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/tv_thought_value_scale_section_header"
                        style="@style/TextView_Header_Section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_thoughts_value_header" />

                    <TextView
                        style="@style/TextView_Info_Success"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/settings_thoughts_value_action_info" />

                    <pl.hexmind.mindshaper.activities.settings.widgets.ThoughtValueSystemTiles
                        android:id="@+id/tiles_value_system"
                        android:layout_width="220dp"
                        android:layout_height="wrap_content" />

                    <!-- Slow mode section -->
                    <TextView
                        android:id="@+id/tv_slow_mode_section_header"
                        style="@style/TextView_Header_Section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_slow_mode_header" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_slow_mode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_slow_mode_label" />

                    <LinearLayout
                        android:id="@+id/ll_slow_mode_hours_picker"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_slow_mode_decrease"
                            style="@style/SecondaryActionButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="35dp"
                            android:text="@string/common_btn_decrease" />

                        <TextView
                            android:id="@+id/tv_slow_mode_hours"
                            android:layout_width="40dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="1"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_slow_mode_increase"
                            style="@style/SecondaryActionButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="35dp"
                            android:text="@string/common_btn_increase" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="h"
                            android:textSize="14sp" />

                    </LinearLayout>

                    <!-- Dormant mode section -->
                    <TextView
                        android:id="@+id/tv_dormant_mode_section_header"
                        style="@style/TextView_Header_Section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_dormant_mode_header" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_dormant_mode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="4dp"
                        android:text="@string/settings_dormant_mode_switch_label" />

                    <LinearLayout
                        android:id="@+id/ll_dormant_thresholds_picker"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical">

                        <!-- Days threshold row -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="180dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:gravity="end"
                                android:text="@string/settings_dormant_mode_days_label"
                                android:textSize="14sp" />

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_dormant_days"
                                android:layout_width="64dp"
                                android:layout_height="40dp"
                                android:background="@drawable/shape_edit_text"
                                android:gravity="center"
                                android:inputType="number"
                                android:maxLength="2"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="dni"
                                android:textSize="14sp" />

                        </LinearLayout>

                        <!-- Value threshold row -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="180dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:gravity="end"
                                android:text="@string/settings_dormant_mode_value_label"
                                android:textSize="14sp" />

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_dormant_value"
                                android:layout_width="64dp"
                                android:layout_height="40dp"
                                android:background="@drawable/shape_edit_text"
                                android:gravity="center"
                                android:inputType="number"
                                android:maxLength="2"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <!-- Validation error for Dormant Mode -->
                        <TextView
                            android:id="@+id/tv_dormant_mode_error"
                            style="@style/TextView_Info_Error"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:layout_marginStart="16dp"
                            android:layout_gravity="center_horizontal"
                            android:visibility="invisible" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- === CALENDAR REMINDERS === -->
            <androidx.cardview.widget.CardView
                style="@style/AppCardView">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tv_calendar_section_header"
                        style="@style/TextView_Header_Section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/settings_calendar_section" />

                    <!-- Turn on/off reminders (toogle) -->
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_calendar_reminders"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_calendar_reminders_switch_label" />

                    <!-- Hint shown under the switch -->
                    <TextView
                        style="@style/TextView_Section_Info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/settings_calendar_reminders_hint" />

                    <TextView
                        android:id="@+id/tv_calendar_choice_label"
                        style="@style/TextView_Section_Info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/settings_calendar_choice_label"
                        android:visibility="gone" />

                    <!-- Calendars list (radio buttons) -->
                    <RadioGroup
                        android:id="@+id/rg_calendar_choice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:visibility="gone" />

                    <!-- Extra sync info -->
                    <TextView
                        style="@style/TextView_Section_Info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/settings_calendar_reminders_sync_hint" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- === DOMAINS === -->
            <androidx.cardview.widget.CardView
                style="@style/AppCardView">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tv_domains_section_header"
                        style="@style/TextView_Header_Section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/settings_domains_header" />

                    <GridLayout
                        android:id="@+id/gl_domains"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:alignmentMode="alignBounds"
                        android:columnCount="2"
                        android:columnOrderPreserved="false"
                        android:rowCount="4" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- === BACKUP === -->
            <androidx.cardview.widget.CardView
                style="@style/AppCardView">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tv_backup_section_header"
                        style="@style/TextView_Header_Section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/settings_backup_header" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_backup_feature"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_permissions_backup" />

                    <TextView
                        style="@style/TextView_Info_Success"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_backup_hint" />

                    <TextView
                        android:id="@+id/tv_snapshot_stats"
                        style="@style/TextView_Info_Success"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_select_backup"
                            style="@style/SecondaryActionButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:text="@string/settings_backup_select" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_load_backup"
                            style="@style/SecondaryActionButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:enabled="false"
                            android:text="@string/settings_backup_load" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_selected_backup"
                        style="@style/TextView_Info_Success"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/files_state_no_file_selected" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <!-- SAVE -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btn_save_settings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:src="@drawable/ic_action_save"
        android:contentDescription="@string/common_placeholder_accessibility_content_desc"
        app:backgroundTint="@color/button_primary_enabled_background"
        app:fabSize="normal"
        app:maxImageSize="32dp"
        app:layout_behavior="com.google.android.material.behavior.HideBottomViewOnScrollBehavior" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>