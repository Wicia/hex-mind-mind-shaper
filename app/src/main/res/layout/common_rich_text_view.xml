<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/shape_hex_content"
    android:backgroundTint="@color/button_content_filled_background"
    android:padding="8dp">

    <!-- HTML Text Display Area -->
    <org.sufficientlysecure.htmltextview.HtmlTextView
        android:id="@+id/html_text_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="90dp"
        android:padding="12dp"
        android:textAlignment="textStart"
        android:textSize="18sp"
        android:letterSpacing="0.0"
        android:textStyle="normal"
        android:textColor="@color/text_primary"
        android:fontFamily="@font/alegreya_regular"
        android:textAllCaps="false"
        android:visibility="visible" />

    <!-- Action bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Empty view for proper positioning action buttons on the right -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Delete button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_delete"
            style="@style/SecondaryActionButton.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:visibility="gone"
            app:icon="@drawable/ic_action_delete"
            app:iconTint="@color/White" />

    </LinearLayout>

</LinearLayout>