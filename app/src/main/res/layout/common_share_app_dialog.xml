<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="18dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Header -->
    <TextView
        style="@style/Dialog_Header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/settings_share_app_teaser" />

    <TextView
        style="@style/Dialog_Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/settings_share_app_info" />

    <!-- QR code of the APK folder link - its own white quiet zone keeps it scannable on a dark background -->
    <ImageView
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_gravity="center_horizontal"
        android:contentDescription="@string/settings_share_app_teaser"
        android:src="@drawable/img_share_qr" />

    <!-- Installed version -->
    <TextView
        android:id="@+id/tv_share_app_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="24dp"
        android:textSize="12sp"
        android:textColor="@color/_gray_lvl_2"
        tools:text="ver 2026_10_22" />

    <!-- Buttons: Copy link / Share -->
    <!-- ! Both match_parent in a wrap_content row = the taller one sets the height of both -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_share_app_copy"
            style="@style/AuxiliaryActionButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/settings_share_app_btn_copy" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_share_app_send"
            style="@style/SecondaryActionButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textStyle="bold"
            android:text="@string/settings_share_app_btn_send" />

    </LinearLayout>

</LinearLayout>
