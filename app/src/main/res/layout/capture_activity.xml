<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_background"
    >

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="90dp">

            <!-- Header -->
            <include layout="@layout/common_header_activity" />

            <!-- SUBJECT (tags come from the note) -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:minWidth="160dp"
                app:boxStrokeColor="@color/_palette_lvl_3"
                app:hintEnabled="false"
                app:hintTextColor="@color/_palette_lvl_3">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_subject"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/shape_edit_text"
                    android:hint="@string/capture_hex_tags_tooltip"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="2"
                    android:minLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- VALIDATION INFO -->
            <TextView
                android:id="@+id/tv_hex_tags_validation_info"
                style="@style/TextView_Info_Success"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="52dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:gravity="start" />

            <!-- =============================== -->
            <!-- THOUGHT REPRESENTATIONS SECTION -->
            <!-- =============================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="90dp"
                android:orientation="vertical">

                <!-- RICH TEXT : Note -->
                <pl.hexmind.mindshaper.common.ui.views.content.HexTextView
                    android:id="@+id/rich_text_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone"
                    app:richTextMode="editDisplay"
                    app:collapsedMaxLines="@integer/note_max_lines" />

                <!-- SOUND RECORDING : Media player for audio -->
                <pl.hexmind.mindshaper.common.ui.views.content.HexAudioView
                    android:id="@+id/audio_recording_playback"
                    style="@style/RecordingPlaybackView_UsedWithTint"
                    app:recordingMode="recordPlayback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:padding="24dp"
                    android:visibility="gone" />

                <!-- PHOTO : Content -->
                <pl.hexmind.mindshaper.common.ui.views.content.HexPhotoView
                    android:id="@+id/photo_display_view"
                    style="@style/PhotoDisplayView_UsedWithTint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone"
                    app:photoMode="captureDisplay"
                    app:compact="true" />

                <!-- ADD CONTENT TOOLBAR -->
                <LinearLayout
                    android:id="@+id/ll_add_content_toolbar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="start"
                    android:layout_gravity="start"
                    android:paddingVertical="4dp">

                    <!-- BTN ADD - Rich Text -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_rich_text_add"
                        style="@style/HexContentButton.NotUsed"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginEnd="4dp"
                        app:icon="@drawable/ic_thought_type_rich_text"
                        app:iconGravity="textEnd"
                        android:text="@string/common_btn_create"
                        app:iconSize="32dp" />

                    <!-- BTN ADD - Recording -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_recording_add"
                        style="@style/HexContentButton.NotUsed"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginEnd="4dp"
                        app:icon="@drawable/ic_thought_type_recording"
                        app:iconGravity="textEnd"
                        android:text="@string/common_btn_create"
                        app:iconSize="32dp" />

                    <!-- BTN ADD - Photo -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_photo_add"
                        style="@style/HexContentButton.NotUsed"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="@string/common_btn_create"
                        app:icon="@drawable/ic_thought_type_photo"
                        app:iconGravity="textEnd"
                        app:iconSize="32dp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- SAVE BUTTON -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btn_save"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:src="@drawable/ic_action_save"
        android:contentDescription="@string/common_placeholder_accessibility_content_desc"
        app:backgroundTint="@color/button_primary_enabled_background"
        app:fabSize="normal"
        app:maxImageSize="32dp"
        app:layout_behavior="com.google.android.material.behavior.HideBottomViewOnScrollBehavior" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>