<?xml version="1.0" encoding="utf-8"?>
<!-- Actions dialog: 1 action = [Cancel | Primary]; 2 actions = [Secondary | Primary] + Cancel below -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <TextView
            android:id="@+id/tv_info_header"
            style="@style/Dialog_Header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            tools:text="Tu idzie pierońsko ważny nagłówek"
            />

        <!-- Optional icon above the description - e.g. a done task -->
        <ImageView
            android:id="@+id/iv_icon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="@string/common_placeholder_accessibility_content_desc"
            android:visibility="gone"
            app:tint="@color/_palette_lvl_3"
            />

        <TextView
            android:id="@+id/tv_description"
            style="@style/Dialog_Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="A tu jakiś mądry tekst..."
            />

        <!-- Buttons of the row share the height of the tallest one (match_parent in a wrap_content row) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Left slot: Cancel (1 action) or secondary action (2 actions) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cancel_inline"
                style="@style/AuxiliaryActionButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="@string/common_btn_cancel"
                />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_action_secondary"
                style="@style/SecondaryActionButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:lineSpacingMultiplier="@dimen/line_spacing_tight"
                tools:text="Druga akcja"
                />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_action_primary"
                style="@style/SecondaryActionButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:lineSpacingMultiplier="@dimen/line_spacing_tight"
                tools:text="Akcja główna"
                />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel_below"
            style="@style/AuxiliaryActionButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:insetLeft="36dp"
            android:insetRight="36dp"
            android:text="@string/common_btn_cancel"
            />

    </LinearLayout>

    <!-- Over the whole dialog, shot from its top corners; not clickable - taps go through to the buttons -->
    <pl.hexmind.mindshaper.common.ui.views.HexConfettiView
        android:id="@+id/cv_confetti"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        />

</FrameLayout>
