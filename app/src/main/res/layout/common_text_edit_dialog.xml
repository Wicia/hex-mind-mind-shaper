<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tv_header"
        style="@style/DialogTile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_gravity="center"
        android:text=":)"
        />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:boxStrokeColor="#FF8C42"
        app:hintTextColor="#FFAF7A">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_input"
            android:background="@drawable/shape_edit_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="100"
            android:minLines="3"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:fontFamily="@font/alegreya_regular"
            android:textSize="18sp" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Markdown toolbar (only for editing rich text notes) -->
    <LinearLayout
        android:id="@+id/toolbar_markdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp"
        android:visibility="visible">

        <!-- Insert bullet point at cursor position -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_insert_bullet"
            style="@style/SecondaryActionButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:focusable="false"
            android:focusableInTouchMode="false"
            app:iconGravity="textStart"
            app:icon="@drawable/ic_action_list" />

    </LinearLayout>

    <TextView
        android:id="@+id/tv_hex_tags_validation_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:textColor="@color/graphite_beige"
        android:layout_marginStart="16dp"
        android:visibility="gone"
        />

</LinearLayout>
