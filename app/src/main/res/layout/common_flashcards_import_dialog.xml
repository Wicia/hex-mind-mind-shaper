<?xml version="1.0" encoding="utf-8"?>
<!-- Import of flashcards from a pasted text (FlashcardsImportDialog) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="16dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="4dp">

    <!-- Header -->
    <TextView
        style="@style/DialogTile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/flashcards_import_header"
        />

    <!-- Separator: label + tiles -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Separator label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="@string/flashcards_import_separator_label"
            android:textColor="@color/graphite_beige"
            />

        <!-- Separator tiles (Enter / Myślnik) -->
        <pl.hexmind.mindshaper.common.ui.views.lists.HexOptionTiles
            android:id="@+id/tiles_flashcards_import_separator"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:compact="true"
            />

    </LinearLayout>

    <!-- Text to import -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:boxStrokeColor="#FF8C42"
        app:hintTextColor="#FFAF7A">

        <!-- ! Hint (format example) is set by the separator -->
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_flashcards_import"
            android:background="@drawable/shape_edit_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:inputType="textMultiLine"
            android:minLines="6"
            android:maxLines="12"
            android:scrollbars="vertical"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:fontFamily="@font/baloo2"
            android:textSize="16sp"
            app:hintEnabled="false"
            />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Parse result: how many flashcards + skipped lines -->
    <TextView
        android:id="@+id/tv_flashcards_import_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/graphite_beige"
        tools:text="Powstanie 12 fiszek (pominięte linie: 1)"
        />

</LinearLayout>
