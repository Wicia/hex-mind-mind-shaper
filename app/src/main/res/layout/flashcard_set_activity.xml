<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    tools:context=".activities.flashcards.FlashcardSetActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="80dp">

            <!-- Activity header (icon + set name) -->
            <include layout="@layout/common_header_activity" />

            <!-- Actions: delete left (app standard: the X always sits on the left), edit + review right -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_set_delete"
                    style="@style/SecondaryActionButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="0dp"
                    android:contentDescription="@string/common_placeholder_accessibility_content_desc"
                    app:icon="@drawable/ic_close"
                    app:iconGravity="textStart"
                    app:iconSize="20dp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_set_edit"
                    style="@style/SecondaryActionButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="0dp"
                    android:contentDescription="@string/common_placeholder_accessibility_content_desc"
                    app:icon="@drawable/ic_action_edit"
                    app:iconGravity="textStart"
                    app:iconSize="20dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_set_review"
                    style="@style/SecondaryActionButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:padding="0dp"
                    android:contentDescription="@string/common_placeholder_accessibility_content_desc"
                    app:icon="@drawable/ic_activity_home"
                    app:iconGravity="textStart"
                    app:iconSize="28dp" />

            </LinearLayout>

            <!-- Flashcards of the set: flashcard_preview_row, in the order they were entered -->
            <LinearLayout
                android:id="@+id/ll_set_flashcards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

            <!-- Empty set -->
            <TextView
                android:id="@+id/tv_set_empty"
                style="@style/TextView_Metadata"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:gravity="center"
                android:text="@string/flashcards_set_no_flashcards"
                android:visibility="gone" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- fab - Add flashcards in a series -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add_flashcards"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:src="@drawable/ic_action_add"
        app:backgroundTint="@color/button_primary_enabled_background"
        app:fabSize="normal"
        app:elevation="6dp"
        android:contentDescription="@string/common_placeholder_accessibility_content_desc" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
