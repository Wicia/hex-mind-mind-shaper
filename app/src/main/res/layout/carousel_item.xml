<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="@color/hex_card_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="center"
        android:padding="24dp">

        <ImageView
            android:id="@+id/iv_icon_hex_tags"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="24dp"
            android:contentDescription="@string/common_placeholder_accessibility_content_desc"
            app:srcCompat="@drawable/ic_decorator_label"
            app:tint="@color/_gray_lvl_2" />

        <!-- RICH TEXT -->
        <pl.hexmind.mindshaper.common.ui.HexTextView
            android:id="@+id/tv_rich_text"
            style="@style/HexTextViewDisplayed.Used"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:maxLines="7"
            android:backgroundTint="@color/hex_card_background"
            android:visibility="gone"/>

        <!-- Simple voice recording playback -->
        <pl.hexmind.mindshaper.activities.capture.handlers.AudioRecordingView
            android:id="@+id/arv_playback"
            app:recordingMode="playbackOnly"
            app:compact="true"
            style="@style/RecordingPlaybackView_UsedWithTint"
            android:background="@null"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:visibility="gone" />

        <!-- EXTRAS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:orientation="vertical">

            <!-- VALUE BAR -->
            <pl.hexmind.mindshaper.common.ui.ValueBar
                android:id="@+id/vb_thought_value"
                style="@style/ValueBar"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_gravity="center"
                app:dotBackgroundColor="@color/app_background"
                android:layout_marginTop="8dp"
                />

            <!-- METADATA -->
            <TextView
                android:id="@+id/tv_though_metadata"
                style="@style/TextView_Metadata_Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAlignment="center" />

        </LinearLayout>
    </LinearLayout>

</androidx.cardview.widget.CardView>
