<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="120dp"
    android:layout_height="120dp"
    android:layout_columnWeight="1"
    android:layout_margin="8dp"
    android:padding="8dp"
    android:orientation="vertical"
    android:gravity="center|top"
    android:background="@drawable/shape_hex_content"
    android:backgroundTint="@color/_orange_lvl_1"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/iv_domain_icon"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_margin="8dp"
        app:tint="@color/_black"
        android:contentDescription="@string/common_placeholder_accessibility_content_desc" />

    <TextView
        android:id="@+id/tv_domain_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="@color/text_primary"
        android:textAlignment="center"
        android:maxLines="2" />

</LinearLayout>