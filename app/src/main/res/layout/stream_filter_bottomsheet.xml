<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/shape_hex_content"
    android:backgroundTint="@color/app_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="80dp">

        <!-- DRAG HANDLE -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp"
            android:background="@color/_gray_lvl_2" />

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_horizontal"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:scaleX="-1"
                android:scaleY="-1"
                android:layout_gravity="center_vertical"
                android:contentDescription="@string/common_placeholder_accessibility_content_desc"
                app:srcCompat="@drawable/ic_decorator_olive"
                app:tint="@color/separator_leaf" />

            <TextView
                style="@style/DialogTile"
                android:textColor="@color/text_secondary"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/stream_filter_dialog_title"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="0dp" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_gravity="center_vertical"
                android:scaleY="-1"
                android:contentDescription="@string/common_placeholder_accessibility_content_desc"
                app:srcCompat="@drawable/ic_decorator_olive"
                app:tint="@color/separator_leaf" />

        </LinearLayout>

        <!-- States: SECTION HEADER -->
        <TextView
            android:id="@+id/tv_states_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            android:text="@string/stream_filter_label_states"
            android:textSize="16sp"
            android:fontFamily="@font/baloo2"
            android:textColor="@color/_gray_lvl_3" />

        <!-- States: ACTIVE THOUGHTS (Checkbox) -->
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cb_show_active"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="4dp"
            android:checked="true"
            android:text="@string/stream_filter_show_active"
            android:fontFamily="@font/baloo2"
            android:textSize="15sp"
            android:textColor="@color/text_primary"
            app:buttonIconTint="@color/_orange_lvl_3" />

        <!-- States: DORMANT THOUGHTS (Checkbox) -->
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cb_show_dormant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="20dp"
            android:checked="false"
            android:text="@string/stream_filter_show_dormant"
            android:fontFamily="@font/baloo2"
            android:textSize="15sp"
            android:textColor="@color/text_primary"
            app:buttonIconTint="@color/_orange_lvl_3" />

        <!-- Domains: SECTION HEADER -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            android:text="@string/common_hex_tags_label_domain"
            android:textSize="16sp"
            android:fontFamily="@font/baloo2"
            android:textColor="@color/_gray_lvl_3" />

        <!-- Domains: GRID -->
        <pl.hexmind.mindshaper.common.ui.views.IconsGridView
            android:id="@+id/igv_domains"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp" />

    </LinearLayout>

    <!-- FAB: Apply filter -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_apply"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:src="@drawable/ic_action_filter"
        app:maxImageSize="32dp"
        app:backgroundTint="@color/button_primary_enabled_background"
        app:fabSize="normal"
        app:elevation="6dp"
        android:contentDescription="@string/common_placeholder_accessibility_content_desc" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
