<?xml version="1.0" encoding="utf-8"?>
<!-- Single tile item — inflated by HexOptionTiles; visual state applied programmatically -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_weight="1"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:minHeight="64dp"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="10dp">

    <ImageView
        android:id="@+id/iv_tile_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginBottom="4dp"
        android:contentDescription="@string/common_placeholder_accessibility_content_desc" />

    <TextView
        android:id="@+id/tv_tile_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/montserrat_regular"
        android:gravity="center"
        android:textSize="12sp" />

</LinearLayout>
