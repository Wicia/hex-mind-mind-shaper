<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ====================================== -->
    <!--    TEXT VIEW -->
    <!-- ====================================== -->

    <!-- Activity / Headers -->
    <style name="TextView_Header_Activity">
        <item name="android:fontFamily">@font/alegreya_regular</item>
        <item name="fontFamily">@font/alegreya_regular</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/_gray_lvl_2</item>
    </style>

    <!-- Activity / Section -->
    <style name="TextView_Header_Section">
        <item name="android:fontFamily">@font/baloo2</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textColor">@color/card_section_header</item>
    </style>

    <!-- TODO: Not used = use or delete -->
    <!-- Activity / Text Standard -->
    <style name="TextView_Standard">
        <item name="android:fontFamily">@font/alegreya_regular</item>
        <item name="android:textSize">18sp</item>
        <item name="android:lineSpacingExtra">1dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextView_Metadata">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/baloo2</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextView_Info_Success">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/validation_success</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="TextView_Section_Info">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/validation_success</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="TextView_Info_Error">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/validation_error</item>
    </style>

    <style name="TextView_Number_State">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/baloo2</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- ====================================== -->
    <!--   CONTENT BUTTONS  -->
    <!-- ====================================== -->

    <!--=== Thought CONTENT ===-->
    <style name="HexContentButton.NotUsed" parent="Widget.MaterialComponents.Button">
        <!-- Min constraints -->
        <item name="android:minHeight">60dp</item>
        <item name="android:minWidth">0dp</item>

        <!-- Insets -->
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>

        <!-- Padding -->
        <item name="android:padding">12dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>

        <!-- Background -->
        <item name="backgroundTint">@color/button_content_empty_background</item>
        <item name="android:background">@drawable/shape_hex_content</item>
        <item name="android:backgroundTint">@color/button_content_empty_background</item>

        <!-- Icons -->
        <item name="iconTint">@color/button_content_empty_icon</item>
        <item name="iconPadding">0dp</item>
        <item name="iconGravity">textStart</item>

        <!-- Corners -->
        <item name="cornerRadius">8dp</item>

        <!-- Texts -->
        <item name="android:textSize">18sp</item>
        <item name="android:letterSpacing">0.0</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/text_on_primary</item>
        <item name="android:fontFamily">@font/alegreya_regular</item>
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
    </style>

    <!--=== Thought METADATA ===-->

    <style name="MetadataContentButton.Used" parent="Widget.MaterialComponents.Button">
        <!-- Min constraints -->
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>

        <!-- Insets -->
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>

        <!-- Padding -->
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingRight">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:padding">8dp</item>

        <!-- Background -->
        <item name="backgroundTint">@color/button_content_filled_background</item>
        <item name="android:background">@drawable/shape_hex_content</item>
        <item name="android:backgroundTint">@color/button_content_filled_background</item>

        <!-- Icons -->
        <item name="iconTint">@color/button_content_filled_icon</item>
        <item name="iconPadding">0dp</item>
        <item name="iconGravity">end</item>

        <!-- Corners -->
        <item name="cornerRadius">12dp</item>

        <!-- Texts -->
        <item name="android:lineSpacingExtra">-1dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0.0</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">@font/baloo2</item>
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="MetadataContentButton.NotUsed" parent="Widget.MaterialComponents.Button">
        <!-- Min constraints -->
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>

        <!-- Insets -->
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>

        <!-- Padding -->
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingRight">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:padding">8dp</item>

        <!-- Background -->
        <item name="backgroundTint">@color/button_content_empty_background</item>
        <item name="android:background">@drawable/shape_hex_content</item>
        <item name="android:backgroundTint">@color/button_content_empty_background</item>

        <!-- Icons -->
        <item name="iconTint">@color/button_content_empty_icon</item>
        <item name="iconPadding">0dp</item>
        <item name="iconGravity">end</item>

        <!-- Corners -->
        <item name="cornerRadius">12dp</item>

        <!-- Texts -->
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0.0</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">@font/baloo2</item>
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="RecordingPlaybackView_UsedWithTint">
        <item name="android:padding">12dp</item>
        <item name="android:background">@drawable/shape_hex_content</item>
        <item name="android:backgroundTint">@color/button_content_filled_background</item>
        <item name="android:orientation">vertical</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="PhotoDisplayView_UsedWithTint">
        <item name="android:padding">12dp</item>
        <item name="android:background">@drawable/shape_hex_content</item>
        <item name="android:backgroundTint">@color/button_content_filled_background</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="RoundedCornerImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <!-- ====================================== -->
    <!--    ACTION / OPERATIONAL BUTTONS        -->
    <!-- ====================================== -->

    <!--=== Parent ===-->

    <style name="BaseActionButton" parent="Widget.MaterialComponents.Button">
        <!-- Min constraints -->
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>

        <!-- Insets -->
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>

        <!-- Padding -->
        <item name="android:padding">12dp</item>

        <!-- Corners -->
        <item name="cornerRadius">8dp</item>

        <!-- Text styling -->
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0.0</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">@font/baloo2</item>
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
    </style>

    <!--=== MAIN ===-->

    <style name="PrimaryActionButton" parent="BaseActionButton">
        <!-- Background -->
        <item name="backgroundTint">@color/button_primary_stateful_background</item>

        <!-- Icons -->
        <item name="iconTint">@color/button_primary_stateful_icon</item>
        <item name="iconSize">28dp</item>
        <item name="iconPadding">0dp</item>
        <item name="iconGravity">textTop</item>

        <!-- Text alignment -->
        <item name="android:textAlignment">textStart</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!--=== SECONDARY ===-->

    <style name="SecondaryActionButton" parent="BaseActionButton">
        <!-- Background -->
        <item name="backgroundTint">@color/button_secondary_stateful_background</item>

        <!-- Icons -->
        <item name="iconTint">@color/button_secondary_stateful_icon</item>
        <item name="iconSize">28dp</item>
        <item name="iconPadding">0dp</item>
        <item name="iconGravity">textTop</item>

        <!-- Text alignment -->
        <item name="android:textAlignment">center</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!--=== AUXILIARY ===-->

    <style name="AuxiliaryActionButton" parent="BaseActionButton">
        <!-- Background -->
        <item name="backgroundTint">@color/button_auxiliary_background</item>

        <!-- Icons -->
        <item name="iconTint">@color/button_auxiliary_icon</item>
        <item name="iconSize">28dp</item>
        <item name="iconPadding">0dp</item>
        <item name="iconGravity">textStart</item>

        <!-- Text alignment -->
        <item name="android:textAlignment">center</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- ====================================== -->
    <!--    DIALOGS -->
    <!-- ====================================== -->

    <!-- Common -->
    <style name="DialogTile">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:baselineAligned">true</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">@font/alegreya_regular</item>
        <item name="android:textColor">@color/app_background</item>
        <item name="android:layout_marginBottom">18dp</item>
    </style>

    <style name="DialogItemText">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/baloo2</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:layout_gravity">center_vertical</item>
        <item name="android:padding">12dp</item>
    </style>

    <!-- Dialogs -->
    <style name="Dialog_Header">
        <item name="android:fontFamily">@font/baloo2</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">24dp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Dialog_Text">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/baloo2</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:layout_gravity">center_vertical</item>
        <item name="android:padding">12dp</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <!-- ====================================== -->
    <!--    IMAGE VIEW -->
    <!-- ====================================== -->

    <style name="ImageView_Header_Activity">
        <item name="android:layout_width">32dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:layout_gravity">center</item>
        <item name="tint">@color/_gray_lvl_2</item>
    </style>

    <!-- ====================================== -->
    <!--    HEX KEYBOARD -->
    <!-- ====================================== -->

    <!-- Standard keyboard buttons -->
    <style name="HexKeyboard_StandardKey">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">3dp</item>
        <item name="android:layout_marginEnd">3dp</item>
        <item name="android:background">@drawable/hex_keyboard_standard_key_background</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">0dp</item>
    </style>

    <!-- Shift, Backspace, Enter, 123... -->
    <style name="HexKeyboard_FunctionKey">
        <item name="android:layout_height">42dp</item>
        <item name="android:layout_marginStart">3dp</item>
        <item name="android:layout_marginEnd">3dp</item>
        <item name="android:background">@drawable/hex_keyboard_function_key_background</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">0dp</item>
    </style>

    <!-- ====================================== -->
    <!--    PROGRESS BARS / INDICATORS          -->
    <!-- ====================================== -->

    <style name="ValueCloude">
        <item name="cloudColor">@color/_orange_lvl_2</item>
        <item name="valueTextColor">@color/graphite_dark</item>
    </style>

    <!-- ====================================== -->
    <!--    CARDS                               -->
    <!-- ====================================== -->

    <style name="AppCardView">
        <item name="cardBackgroundColor">@android:color/white</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">3dp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">16dp</item>
    </style>

    <!-- Suppress Material3 default box decoration; custom background handles the border -->
    <style name="InputLayout_NoBox" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundMode">none</item>
    </style>

    <style name="HexInputHintAppearance" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/_gray_lvl_3</item>
    </style>

    <style name="ChipPresetButton" parent="Widget.MaterialComponents.Button">
        <!-- Min constraints -->
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>

        <!-- Insets -->
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>

        <!-- Padding -->
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>

        <!-- Background (selector) -->
        <item name="android:background">@drawable/shape_chip_preset_selector</item>
        <item name="backgroundTint">@null</item>

        <!-- Text -->
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.0</item>
        <item name="android:letterSpacing">0.0</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
        <item name="android:fontFamily">@font/baloo2</item>

        <!-- Text color -->
        <item name="android:textColor">@color/text_primary</item>

        <!-- Elevation / ripple -->
        <item name="android:stateListAnimator">@null</item>
        <item name="rippleColor">@color/_orange_lvl_2</item>
        <item name="cornerRadius">16dp</item>
    </style>

</resources>