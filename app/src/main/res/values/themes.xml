<resources>

    <!-- Base application theme for light mode -->
    <style name="Theme.MindShaper" parent="Theme.Material3.Light">

        <!-- Color palette: orange by default, the picked one is applied on top by ColorPalette -->
        <item name="paletteLvl0">@color/_palette_orange_lvl_0</item>
        <item name="paletteLvl1">@color/_palette_orange_lvl_1</item>
        <item name="paletteLvl2">@color/_palette_orange_lvl_2</item>
        <item name="paletteLvl3">@color/_palette_orange_lvl_3</item>
        <item name="paletteLvl0FadeStart">@color/_palette_orange_lvl_0_fade_start</item>
        <item name="paletteLvl0FadeEnd">@color/_palette_orange_lvl_0_fade_end</item>
        <item name="paletteDeckLayer1">@color/_palette_orange_deck_layer_1</item>
        <item name="paletteDeckLayer2">@color/_palette_orange_deck_layer_2</item>
        <item name="paletteDeckLayer3">@color/_palette_orange_deck_layer_3</item>
        <item name="paletteDeckLayer4">@color/_palette_orange_deck_layer_4</item>
        <item name="paletteStampGood">@color/_palette_orange_stamp_good</item>

        <!-- Primary color -->
        <item name="colorPrimary">@color/app_primary</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>
        <item name="colorPrimaryContainer">@color/_palette_lvl_2</item>
        <item name="colorOnPrimaryContainer">@color/text_primary</item>

        <!-- Secondary color -->
        <item name="colorSecondary">@color/app_secondary</item>
        <item name="colorOnSecondary">@color/_white</item>
        <item name="colorSecondaryContainer">@color/_palette_lvl_0</item>
        <item name="colorOnSecondaryContainer">@color/text_primary</item>

        <!-- Surface color -->
        <item name="colorSurface">@color/app_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/_palette_lvl_0</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>

        <!-- Background color -->
        <item name="android:colorBackground">@color/app_background</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="android:windowBackground">@drawable/bg_app_background</item>

        <!-- Error color -->
        <item name="colorError">@color/validation_error</item>
        <item name="colorOnError">@color/validation_error</item>

        <!-- Status bar and navigation -->
        <item name="android:statusBarColor">@color/graphite_dark</item>
        <item name="android:navigationBarColor">@color/graphite_dark</item>

        <!-- Force android to always load common theme (no dark/light) -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:forceDarkAllowed">false</item>

        <!-- Use custom InputLayout style with no Material box decoration -->
        <item name="textInputStyle">@style/InputLayout_NoBox</item>
        <item name="android:fontFamily">@font/baloo2</item>
        <item name="fontFamily">@font/baloo2</item>

    </style>

    <!-- Color palettes - overlays applied on the activity and application theme (ColorPalette) -->
    <style name="ThemeOverlay.MindShaper.Palette.Orange" parent="">
        <item name="paletteLvl0">@color/_palette_orange_lvl_0</item>
        <item name="paletteLvl1">@color/_palette_orange_lvl_1</item>
        <item name="paletteLvl2">@color/_palette_orange_lvl_2</item>
        <item name="paletteLvl3">@color/_palette_orange_lvl_3</item>
        <item name="paletteLvl0FadeStart">@color/_palette_orange_lvl_0_fade_start</item>
        <item name="paletteLvl0FadeEnd">@color/_palette_orange_lvl_0_fade_end</item>
        <item name="paletteDeckLayer1">@color/_palette_orange_deck_layer_1</item>
        <item name="paletteDeckLayer2">@color/_palette_orange_deck_layer_2</item>
        <item name="paletteDeckLayer3">@color/_palette_orange_deck_layer_3</item>
        <item name="paletteDeckLayer4">@color/_palette_orange_deck_layer_4</item>
        <item name="paletteStampGood">@color/_palette_orange_stamp_good</item>
    </style>

    <style name="ThemeOverlay.MindShaper.Palette.Coffee" parent="">
        <item name="paletteLvl0">@color/_palette_coffee_lvl_0</item>
        <item name="paletteLvl1">@color/_palette_coffee_lvl_1</item>
        <item name="paletteLvl2">@color/_palette_coffee_lvl_2</item>
        <item name="paletteLvl3">@color/_palette_coffee_lvl_3</item>
        <item name="paletteLvl0FadeStart">@color/_palette_coffee_lvl_0_fade_start</item>
        <item name="paletteLvl0FadeEnd">@color/_palette_coffee_lvl_0_fade_end</item>
        <item name="paletteDeckLayer1">@color/_palette_coffee_deck_layer_1</item>
        <item name="paletteDeckLayer2">@color/_palette_coffee_deck_layer_2</item>
        <item name="paletteDeckLayer3">@color/_palette_coffee_deck_layer_3</item>
        <item name="paletteDeckLayer4">@color/_palette_coffee_deck_layer_4</item>
        <item name="paletteStampGood">@color/_palette_coffee_stamp_good</item>
    </style>

    <!-- Theme for activity without action bar -->
    <style name="Theme.MindShaper.NoActionBar" parent="Theme.MindShaper">
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowFullscreen">false</item>
    </style>

    <!-- Landscape review session - dark from the first frame, light bar icons on it -->
    <style name="Theme.MindShaper.FlashcardsSession" parent="Theme.MindShaper.NoActionBar">
        <item name="android:windowBackground">@color/flashcard_session_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Deep-link handler theme (intentionally invisible — no UI) -->
    <style name="Theme.MindShaper.Transparent" parent="Theme.MindShaper.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

</resources>