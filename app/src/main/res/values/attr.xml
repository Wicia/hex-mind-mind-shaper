<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- To resolve problem with duplication (same attribute used in different widgets) -->
    <attr name="compact" format="boolean" />

    <declare-styleable name="ValueBar">
        <attr name="radius" format="dimension" />
        <attr name="level" format="integer" />
        <attr name="maxLevel" format="integer" />
        <attr name="minDotRadius" format="dimension" />
        <attr name="maxDotRadius" format="dimension" />
        <attr name="dotBackgroundColor" format="color" />
        <attr name="dotProgressColor" format="color" />
        <attr name="dotTextColor" format="color" />
        <attr name="showLevelText" format="boolean" />
    </declare-styleable>

    <declare-styleable name="ValueCloude">
        <attr name="squareSize" format="dimension" />
        <attr name="level" />
        <attr name="squareColor" format="reference|color" />
        <attr name="textColor" format="reference|color" />
        <attr name="showLevelText" />
        <attr name="textSize" format="dimension" />
    </declare-styleable>

    <declare-styleable name="AudioRecordingView">
        <attr name="recordingMode" format="enum">
            <enum name="recordPlayback" value="0" />
            <enum name="playbackOnly" value="1" />
        </attr>
        <attr name="compact" />
    </declare-styleable>

    <declare-styleable name="PhotoDisplayView">
        <attr name="photoMode" format="enum">
            <enum name="captureDisplay" value="0" />
            <enum name="displayOnly" value="1" />
        </attr>
        <attr name="compact" />
    </declare-styleable>

    <declare-styleable name="HexTextView">
        <attr name="richTextMode" format="enum">
            <enum name="editDisplay" value="0" />
            <enum name="displayOnly" value="1" />
        </attr>
    </declare-styleable>

</resources>