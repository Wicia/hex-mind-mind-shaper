<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Space around hex tag pills (Metadata lists) - the single all-around margin knob -->
    <dimen name="hex_tag_pill_spacing">12dp</dimen>

    <!-- Review progress bar along the bottom edge of the flashcard -->
    <dimen name="flashcard_progress_height">4dp</dimen>

    <!-- Session actions of the flashcard: reveal / skip / close vs the bigger rating faces -->
    <dimen name="flashcard_action_icon_size">32dp</dimen>
    <dimen name="flashcard_rating_icon_size">36dp</dimen>

    <!-- Landscape review session (HexFlashcardsSessionView) -->
    <!-- Rating pile: visible depth x length - the top pile is the side one turned by 90 degrees -->
    <dimen name="flashcard_zone_depth">80dp</dimen>
    <dimen name="flashcard_zone_length">280dp</dimen>
    <!-- Part of the pile off the screen - cuts off its frame and corners on the edge side, so it reads as a piece of the screen -->
    <dimen name="flashcard_zone_overhang">30dp</dimen>
    <dimen name="flashcard_zone_overhang_negative">-30dp</dimen>
    <!-- depth + overhang -->
    <dimen name="flashcard_zone_depth_total">110dp</dimen>
    <dimen name="flashcard_zone_radius">24dp</dimen>
    <dimen name="flashcard_zone_frame_width">2dp</dimen>
    <dimen name="flashcard_zone_dash">6dp</dimen>
    <dimen name="flashcard_zone_dash_gap">4dp</dimen>
    <dimen name="flashcard_zone_face_size">40dp</dimen>
    <dimen name="flashcard_session_card_width">370dp</dimen>
    <dimen name="flashcard_session_card_height">214dp</dimen>
    <dimen name="flashcard_session_card_radius">22dp</dimen>
    <!-- Auto size range of the card text: the back is smaller than the front -->
    <dimen name="flashcard_session_text_min">14sp</dimen>
    <dimen name="flashcard_session_front_text_max">27sp</dimen>
    <dimen name="flashcard_session_back_text_max">21sp</dimen>
    <!-- How far the card has to go towards a pile - the direction counts, the pile itself needs no hitting -->
    <dimen name="flashcard_session_throw_side">110dp</dimen>
    <dimen name="flashcard_session_throw_up">60dp</dimen>
    <dimen name="flashcard_session_stamp_radius">10dp</dimen>
    <dimen name="flashcard_session_stamp_frame_width">3dp</dimen>
    <!-- Same width as the pill's frame - the countdown covers it -->
    <dimen name="flashcard_session_undo_countdown_width">2dp</dimen>

    <!-- Level bar in the set preview (vertical twin of the session progress) -->
    <dimen name="flashcard_level_bar_width">4dp</dimen>

    <!-- Gap between the flashcard rows in the set edit dialog -->
    <dimen name="flashcards_edit_row_spacing">12dp</dimen>

    <!-- Text buttons at the bottom right of dialogs (Cancel / Save ...) - one size everywhere -->
    <dimen name="dialog_text_button_size">14sp</dimen>

    <!-- Gap between those buttons -->
    <dimen name="dialog_text_buttons_gap">12dp</dimen>

    <!-- Content's action at the left end of the dialog button bar (ScrimDialogs leadingAction) -->
    <dimen name="dialog_leading_action_height">40dp</dimen>
    <dimen name="dialog_leading_action_icon_size">20dp</dimen>
    <!-- ! Move icon is thin and detailed - at 20dp it reads smaller than the plain "+" -->
    <dimen name="dialog_leading_action_move_icon_size">26dp</dimen>
    <dimen name="dialog_leading_action_margin_start">12dp</dimen>

    <!-- Tight line spacing (lineSpacingMultiplier) of multi-line labels - action buttons, flashcard front -->
    <item name="line_spacing_tight" format="float" type="dimen">0.80</item>

    <!-- Note text - the same size when shown (HexTextView) and when edited (TextEditDialog) -->
    <dimen name="note_text_size">16sp</dimen>
</resources>
