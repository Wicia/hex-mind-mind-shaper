<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Space around hex tag pills (Metadata lists) - the single all-around margin knob -->
    <dimen name="hex_tag_pill_spacing">12dp</dimen>

    <!-- Review progress bar along the bottom edge of the flashcard -->
    <dimen name="flashcard_progress_height">4dp</dimen>

    <!-- Level bar in the set preview (vertical twin of the session progress) -->
    <dimen name="flashcard_level_bar_width">4dp</dimen>

    <!-- Gap between the flashcard rows in the set edit dialog -->
    <dimen name="flashcards_edit_row_spacing">12dp</dimen>

    <!-- Text buttons at the bottom right of dialogs (Cancel / Save ...) - one size everywhere -->
    <dimen name="dialog_text_button_size">14sp</dimen>

    <!-- Gap between those buttons -->
    <dimen name="dialog_text_buttons_gap">12dp</dimen>

    <!-- Content's action at the left end of the dialog button bar (ScrimDialogs leadingAction) -->
    <dimen name="dialog_leading_action_height">40dp</dimen>
    <dimen name="dialog_leading_action_icon_size">20dp</dimen>
    <dimen name="dialog_leading_action_margin_start">12dp</dimen>
</resources>
