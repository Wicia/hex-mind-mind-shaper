<?xml version="1.0" encoding="utf-8"?>
<resources>

<!-- ====================================== -->
<!--    CORE PALETTE -->
<!-- ====================================== -->

    <!-- ORANGE: Main orange color for the app theme -->
    <!-- 0..3 -> color intensity -->
    <color name="_orange_lvl_0">#FFF4E6</color>     <!-- APP BACKGROUND (neutral orange) -->
    <color name="_orange_lvl_1">#FFE1C8</color>     <!-- TERTIARY: list actions + other -->
    <color name="_orange_lvl_2">#EDFFCA98</color>   <!-- SECONDARY: activity secondary actions -->
    <color name="_orange_lvl_3">#FF9F49</color>     <!-- PRIMARY: fab buttons & activity main action -->

    <!-- NEUTRAL: Grayscale for text and backgrounds -->
    <color name="_white">#FFFFFF</color>

    <color name="_gray_lvl_1">#EEEEEE</color>        <!-- background, cards -->
    <color name="_gray_lvl_2">#BDBDBD</color>        <!-- subtle borders, inactive elements -->
    <color name="_gray_lvl_3">#757575</color>        <!-- secondary text, icons -->
    <color name="_gray_lvl_4">#424242</color>        <!-- primary text -->

    <color name="_black">#000000</color>

    <color name="graphite_dark">#FF2F2C2A</color>
    <color name="graphite_medium">#FF48433F</color>
    <color name="graphite_light">#FF625A54</color>
    <color name="graphite_beige">#FFF6EFE8</color>

<!-- ====================================== -->
<!--    SEMANTIC COLORS -->
<!-- ====================================== -->

    <!-- Success, error, warning states -->
    <color name="validation_success">@color/_gray_lvl_3</color>
    <color name="validation_error">#480808</color>
    <color name="info_blue">#1976D2</color>

<!-- ====================================== -->
<!--    APP THEME MAPPINGS -->
<!-- ====================================== -->

    <color name="app_primary">@color/_orange_lvl_3</color>
    <color name="app_primary_variant">@color/_orange_lvl_3</color>

    <color name="app_secondary">@color/_orange_lvl_3</color>
    <color name="app_secondary_variant">@color/_orange_lvl_3</color>

    <color name="app_background">@color/_orange_lvl_0</color>
    <color name="app_surface">@color/_white</color>

<!-- ====================================== -->
<!--    TEXT COLORS -->
<!-- ====================================== -->

    <!-- Content -->
    <color name="text_primary">@color/graphite_medium</color>
    <color name="text_secondary">@color/graphite_light</color>
    <color name="text_secondary_darkmode">@color/graphite_beige</color>

    <color name="text_on_primary">@color/_white</color>
    <color name="text_on_secondary">@color/_white</color>

    <!-- Bullet points -->
    <color name="text_bullet_point">@color/_gray_lvl_3</color>

<!-- ====================================== -->
<!--    WIDGET COLORS -->
<!-- ====================================== -->

    <!-- Input controls -->
    <color name="input_background">@color/_white</color>
    <color name="input_stroke">@color/app_background</color>
    <color name="input_focused">@color/_orange_lvl_3</color>

<!-- ====================================== -->
<!--    ACTION BUTTONS -->
<!-- ====================================== -->

    <!-- Primary -->
    <color name="button_primary_enabled_background">@color/_orange_lvl_3</color>
    <color name="button_primary_enabled_icon">@color/_orange_lvl_2</color>

    <color name="button_primary_disabled_background">@color/_gray_lvl_3</color>
    <color name="button_primary_disabled_icon">@color/_gray_lvl_2</color>

    <!-- Secondary -->
    <color name="button_secondary_enabled_background">@color/_orange_lvl_2</color>
    <color name="button_secondary_enabled_icon">@color/_gray_lvl_1</color>

    <color name="button_secondary_disabled_background">@color/_gray_lvl_2</color>
    <color name="button_secondary_disabled_icon">@color/_gray_lvl_2</color>

    <!--  Auxiliary (no disabled state) -->
    <color name="button_auxiliary_background">@color/_orange_lvl_1</color>
    <color name="button_auxiliary_icon">@color/_gray_lvl_2</color>

<!-- ====================================== -->
<!--    CONTENT BUTTONS -->
<!-- ====================================== -->

    <color name="button_content_not_used_background">@color/_orange_lvl_1</color>
    <color name="button_content_not_used_icon">@color/_orange_lvl_0</color>

    <color name="button_content_used_background">@color/_orange_lvl_1</color>
    <color name="button_content_used_icon">@color/_orange_lvl_0</color>

<!-- ====================================== -->
<!--    CARD VIEWS -->
<!-- ====================================== -->

    <!-- Card views -->
    <color name="hex_card_background">@color/_orange_lvl_2</color>

<!-- ====================================== -->
<!--    LIST ITEMS -->
<!-- ====================================== -->

    <color name="list_icons_item_background">@color/_orange_lvl_1</color>

<!-- ====================================== -->
<!--    DECORATORS -->
<!-- ====================================== -->

    <!-- Separator / dividers -->
    <color name="separator_background">@color/_orange_lvl_2</color>
    <color name="separator_card">@color/_orange_lvl_0</color>

    <!-- Leafs -->
    <color name="separator_leaf">@color/_gray_lvl_2</color>

</resources>