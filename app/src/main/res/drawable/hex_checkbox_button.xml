<?xml version="1.0" encoding="utf-8"?>
<!-- Checkbox box: outline only, a tick inside once checked (no fill) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:drawable="@drawable/hex_checkbox_checked" />
    <item android:drawable="@drawable/hex_checkbox_unchecked" />
</selector>
