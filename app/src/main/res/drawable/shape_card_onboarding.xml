<?xml version="1.0" encoding="utf-8"?>
<!-- TODO: maybe create 1 shape + modify it instead of multiple the same? -->
<!-- Standalone card: same white outline as shape_card_tab_joined, but rounded on all four corners -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Border -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <!-- Surface -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <corners android:radius="11dp" />
        </shape>
    </item>

</layer-list>
