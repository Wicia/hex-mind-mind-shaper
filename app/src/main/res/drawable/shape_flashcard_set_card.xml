<?xml version="1.0" encoding="utf-8"?>
<!-- Set card on the Zestawy list: flashcard card + accent edge on the left, thickest mid-side and thinning out around the rounded corners.
     ! The accent layer goes first - the card's outline (elevation shadow) comes from the first layer -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/flashcard_accent" />
        </shape>
    </item>
    <item android:left="@dimen/flashcard_set_edge_width">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/flashcard_background" />
        </shape>
    </item>
</layer-list>
